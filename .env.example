# DyPortfolio Environment Variables Template (General Version)

# Supabase Configuration (Optional - runs in offline template mode if unset)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Designated Admin Email (Replace with your own email)
VITE_ADMIN_EMAIL=your-email@example.com

# Optional: Cloudflare Turnstile Anti-Bot Site Key
VITE_TURNSTILE_SITE_KEY=
